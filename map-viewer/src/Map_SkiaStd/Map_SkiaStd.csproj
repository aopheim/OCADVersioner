<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Thin wrapper over vendored PurplePen Map_SkiaStd sources (BSD 3-Clause,
    (c) Peter Golde). Sources unmodified; see vendor/UPSTREAM.md.

    This is the SkiaSharp implementation of IGraphicsTarget, plus Skia_TextMetrics,
    SkiaFontLoader and Skia_FileLoader. It is the reason no renderer has to be
    written: it is pure managed net10.0 with no Windows dependencies, and SkiaSharp
    ships WebAssembly native assets.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Map_SkiaStd</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(VendorDir)Map_SkiaStd\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <!-- Pinned to [2.1.3] for the Apache-2.0 licence; see Directory.Packages.props. -->
    <PackageReference Include="SixLabors.ImageSharp" NoWarn="NU1901;NU1902;NU1903;NU1904" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Graphics2D\Graphics2D.csproj" />
    <ProjectReference Include="..\MapModel\MapModel.csproj" />
  </ItemGroup>

</Project>
