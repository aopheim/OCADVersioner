@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Two synced Leaflet maps. Blazor owns the page and the state; Leaflet owns the
    viewport; the tiles come from .NET. The JS module is the only place that knows
    about Leaflet, so nothing above this component has to.
*@

@*
    The same grid as Angular's ocad-map-viewer: two columns with a hair of gutter,
    each map 80vh on white. The captions the spike used are gone - the comparison
    header above already names both sides, which is where Angular says it.
*@
<div class="row g-1">
    <div class="col-sm-6">
        <div @ref="leftEl" class="mapDiv"></div>
    </div>
    <div class="col-sm-6">
        <div @ref="rightEl" class="mapDiv"></div>
    </div>
</div>

@code {
    private ElementReference leftEl;
    private ElementReference rightEl;
    private IJSObjectReference module;
    private IJSObjectReference maps;

    /// <summary>Raised after a map is loaded, with what the parser reported.</summary>
    [Parameter] public EventCallback<MapLoadInfo> OnMapLoaded { get; set; }

    public sealed record MapLoadInfo(
        int Version, double MinX, double MinY, double MaxX, double MaxY,
        long ParseMs, string Georeference);

    /// <summary>
    /// Importing the module and building the two Leaflet maps. Held as a task
    /// rather than a flag because a caller can arrive before it has finished.
    /// </summary>
    private Task ready;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            ready ??= InitialiseAsync();
    }

    private async Task InitialiseAsync()
    {
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/leafletViewport.js");
        maps = await module.InvokeAsync<IJSObjectReference>("createSyncedMaps", leftEl, rightEl);
    }

    /// <summary>Parses <paramref name="bytes"/> into a slot and shows it there.</summary>
    /// <param name="slot">0 for the left map, 1 for the right.</param>
    public async Task<MapLoadInfo> LoadAsync(int slot, string fileName, byte[] bytes)
    {
        // The parent can get here before this component's own first render has
        // finished setting up - the renderer does not wait for a child's
        // OnAfterRenderAsync before running the parent's. Starting the work here
        // if it has not started, and awaiting it either way, removes the race
        // rather than reporting it as "not initialised yet", which is what a
        // caller doing nothing wrong used to see.
        await (ready ??= InitialiseAsync());

        MapLoadInfo info = await maps.InvokeAsync<MapLoadInfo>("loadInto", slot, fileName, bytes);
        await OnMapLoaded.InvokeAsync(info);
        return info;
    }

    public async ValueTask DisposeAsync()
    {
        // The page can be torn down mid-render; JS may already be gone.
        try {
            if (maps is not null) {
                await maps.InvokeVoidAsync("dispose");
                await maps.DisposeAsync();
            }
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (JSDisconnectedException) {
        }
        catch (ObjectDisposedException) {
        }
    }
}
