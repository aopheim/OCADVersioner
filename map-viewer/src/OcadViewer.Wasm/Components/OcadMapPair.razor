@using OcadViewer.Loading
@using OcadViewer.Versioning
@using OcadViewer.Wasm.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Two synced Leaflet maps. Blazor owns the page and the state; JavaScript owns
    the viewport, the file reading and the renderer behind them. This component
    says which version belongs on which side, and where its file is, and learns
    what the parser found; map bytes never pass through .NET at all.
*@

@*
    The same grid as Angular's ocad-map-viewer: two columns with a hair of gutter,
    each map 80vh on white. The comparison header above names both sides, which
    is where Angular says it.
*@
<div class="row g-1">
    <div class="col-sm-6">
        <div @ref="leftEl" class="mapDiv"></div>
    </div>
    <div class="col-sm-6">
        <div @ref="rightEl" class="mapDiv"></div>
    </div>
</div>

@code {
    private ElementReference leftEl;
    private ElementReference rightEl;
    private IJSObjectReference module;
    private IJSObjectReference workspace;

    /// <summary>One map to put on one side.</summary>
    /// <param name="Source">
    /// Which version, where its file is, and whether it must be read again even
    /// if it is already parsed. A release never changes, so showing one that is
    /// already in memory costs no read and no parse.
    /// </param>
    public sealed record MapRequest(MapSide Side, MapSource Source);

    /// <summary>
    /// Told as tiles land in a pane: how many are drawn, and how many it asked for.
    /// </summary>
    /// <remarks>
    /// Facts, not a percentage: what a piece of work is worth against the rest is
    /// <see cref="LoadPlan"/>'s judgement, and this component has no business
    /// having a second opinion about it. One per draw, so JavaScript never has to
    /// say which map or which load a report belongs to - the caller's own closure
    /// already knows.
    /// </remarks>
    public sealed class TileReporter(Action<int, int> onTiles)
    {
        [JSInvokable]
        public void Tiles(int drawn, int asked) => onTiles(drawn, asked);
    }

    /// <summary>
    /// What the change overlay drew, for reporting.
    /// </summary>
    /// <param name="ShownPixels">
    /// How many pixels changed, counted in JavaScript where the mask is.
    /// </param>
    public sealed record ChangeSummary(
        bool Shown, int Width, int Height, double ComputedMs,
        int ShownPixels, int TotalPixels);

    /// <summary>A rectangle of the map, in paper millimetres.</summary>
    public sealed record PaperArea(double MinX, double MinY, double MaxX, double MaxY);

    /// <summary>
    /// Importing the module and building the workspace. Held as a task rather than
    /// a flag because a caller can arrive before it has finished.
    /// </summary>
    private Task ready;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            ready ??= InitialiseAsync();
    }

    private async Task InitialiseAsync()
    {
        module = await JS.ImportAsync("./js/mapWorkspace.js");
        workspace = await module.InvokeAsync<IJSObjectReference>("createWorkspace", leftEl, rightEl);
    }

    /// <summary>
    /// What a load will cost, before starting it.
    /// </summary>
    /// <returns>One step per map, in the order given.</returns>
    public async Task<IReadOnlyList<LoadStep>> PlanAsync(IReadOnlyList<MapRequest> maps)
    {
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<IReadOnlyList<LoadStep>>("plan", OnTheWire(maps));
    }

    /// <summary>
    /// Makes sure a version is parsed, reading the file only if it has to.
    /// </summary>
    /// <remarks>
    /// Parsing and drawing are separate calls so the page can decide, between
    /// them, whether the load is still wanted - a parse already running is one
    /// blocking call and cannot be stopped, but the next one need not start.
    /// </remarks>
    public async Task<MapSummary> ParseAsync(MapRequest map)
    {
        // The parent can get here before this component's own first render has
        // finished setting up - the renderer does not wait for a child's
        // OnAfterRenderAsync before running the parent's. Starting the work here
        // if it has not started, and awaiting it either way, removes the race.
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<MapSummary>("parse", OnTheWire(map));
    }

    /// <summary>
    /// Puts a parsed version in its pane, and waits until the pane has drawn it.
    /// </summary>
    /// <param name="onTiles">Told (drawn, asked for) as tiles land.</param>
    /// <remarks>
    /// Also finishes, early, when another map takes the pane: the tiles this was
    /// waiting for are dropped then and will never land.
    /// </remarks>
    public async Task DrawAsync(MapRequest map, Action<int, int> onTiles)
    {
        await (ready ??= InitialiseAsync());

        using DotNetObjectReference<TileReporter> reporter =
            DotNetObjectReference.Create(new TileReporter(onTiles));

        await workspace.InvokeVoidAsync("draw", OnTheWire(map), reporter);
    }

    /// <summary>
    /// One map, in the shape JavaScript reads it.
    /// </summary>
    /// <remarks>
    /// The side is a spelled-out name rather than <see cref="MapSide"/> itself,
    /// because Blazor serialises an enum as its ordinal - which would put a bare
    /// 0 and 1 back on the wire and undo the point of the enum having names.
    /// </remarks>
    private sealed record JsRequest(string Side, string VersionName, string Path, bool Reload);

    /// <summary>
    /// The requests as one argument.
    /// </summary>
    /// <remarks>
    /// A list and not an array on purpose. Interop takes <c>params object[]</c>,
    /// and C# arrays are covariant, so any array of references is read as the
    /// argument list itself - the two maps then arrive in JavaScript as two
    /// arguments rather than as one array, and the method is handed a request
    /// where it expects a sequence of them.
    /// </remarks>
    private static List<JsRequest> OnTheWire(IReadOnlyList<MapRequest> maps)
        => [.. maps.Select(OnTheWire)];

    private static JsRequest OnTheWire(MapRequest map)
        => new(map.Side.JsName(), map.Source.Name, map.Source.Path, map.Source.Reload);

    /// <summary>
    /// Shows where two versions differ, as a tinted overlay on the newer one.
    /// </summary>
    /// <remarks>
    /// The mask costs two whole-map renders, so it is computed once per
    /// comparison and kept, image and all - turning the overlay off and on
    /// again is free.
    /// </remarks>
    public async Task<ChangeSummary> ShowChangesAsync(
        string olderVersion, string newerVersion, bool show)
    {
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<ChangeSummary>(
            "showChanges", olderVersion, newerVersion, show);
    }

    /// <summary>
    /// Moves both panes to frame everything the overlay is currently showing.
    /// </summary>
    /// <returns>The framed rectangle, or null if nothing is shown.</returns>
    public async Task<PaperArea> ZoomToChangesAsync()
    {
        if (workspace is null)
            return null;

        return await workspace.InvokeAsync<PaperArea>("zoomToChanges");
    }

    /// <summary>
    /// Forgets every parsed map and change mask, because a different project
    /// folder is about to be shown.
    /// </summary>
    /// <remarks>
    /// Maps are held by version name, and every project has a "V1".
    /// </remarks>
    public async Task ResetAsync()
    {
        await (ready ??= InitialiseAsync());
        await workspace.InvokeVoidAsync("reset");
    }

    public async ValueTask DisposeAsync()
    {
        await workspace.ReleaseAsync("dispose");
        await module.ReleaseAsync();
    }
}
