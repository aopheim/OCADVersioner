@using OcadViewer.Wasm.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Two synced Leaflet maps. Blazor owns the page and the state; JavaScript owns
    the viewport, the file reading and the renderer behind them. This component
    says which version belongs on which side and learns what the parser found;
    map bytes never pass through .NET at all.
*@

@*
    The same grid as Angular's ocad-map-viewer: two columns with a hair of gutter,
    each map 80vh on white. The captions the spike used are gone - the comparison
    header above already names both sides, which is where Angular says it.
*@
<div class="row g-1">
    <div class="col-sm-6">
        <div @ref="leftEl" class="mapDiv"></div>
    </div>
    <div class="col-sm-6">
        <div @ref="rightEl" class="mapDiv"></div>
    </div>
</div>

@code {
    private ElementReference leftEl;
    private ElementReference rightEl;
    private IJSObjectReference module;
    private IJSObjectReference workspace;

    /// <summary>What the parser reported about one version.</summary>
    public sealed record MapInfo(
        string Key, int Version, double MinX, double MinY, double MaxX, double MaxY,
        double ParseMs, string Georeference);

    /// <summary>Which kinds of change the overlay shows.</summary>
    /// <param name="Added">
    /// Ink that appeared, and ink that changed to other ink - everything except
    /// an outright removal.
    /// </param>
    /// <param name="Deleted">Ink that went back to blank paper.</param>
    public sealed record ChangeFilters(bool Added, bool Deleted);

    /// <summary>What the change overlay drew, for reporting.</summary>
    public sealed record ChangeSummary(
        bool Shown, int Width, int Height, double ComputedMs, ChangeCounts Counts);

    /// <summary>How many pixels fell into each kind.</summary>
    public sealed record ChangeCounts(int Unchanged, int Appeared, int Vanished, int Altered);

    /// <summary>
    /// Importing the module and building the workspace. Held as a task rather than
    /// a flag because a caller can arrive before it has finished.
    /// </summary>
    private Task ready;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            ready ??= InitialiseAsync();
    }

    private async Task InitialiseAsync()
    {
        module = await JS.ImportAsync("./js/mapWorkspace.js");
        workspace = await module.InvokeAsync<IJSObjectReference>("createWorkspace", leftEl, rightEl);
    }

    /// <summary>
    /// Shows a version on one side.
    /// </summary>
    /// <param name="versionName">"current" for the working file, otherwise "V3".</param>
    /// <param name="reload">
    /// Whether the file must be re-read even if that version is already parsed.
    /// True for the working file, which changes on disk while the app is open.
    /// A release never changes, so showing one that is already in memory costs
    /// nothing - no read, no parse.
    /// </param>
    public async Task<MapInfo> ShowAsync(MapSide side, string versionName, bool reload)
    {
        // The parent can get here before this component's own first render has
        // finished setting up - the renderer does not wait for a child's
        // OnAfterRenderAsync before running the parent's. Starting the work here
        // if it has not started, and awaiting it either way, removes the race
        // rather than reporting it as "not initialised yet", which is what a
        // caller doing nothing wrong used to see.
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<MapInfo>(
            "show", side.JsName(), versionName, reload);
    }

    /// <summary>
    /// Shows where two versions differ, as a tinted overlay on both panes.
    /// </summary>
    /// <remarks>
    /// The mask costs two whole-map renders, so it is computed once per
    /// comparison and kept; changing which kinds are shown only repaints it.
    /// Passing filters that show nothing takes the overlay away.
    /// </remarks>
    public async Task<ChangeSummary> ShowChangesAsync(
        string olderVersion, string newerVersion, ChangeFilters filters)
    {
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<ChangeSummary>(
            "showChanges", olderVersion, newerVersion, filters);
    }

    public async ValueTask DisposeAsync()
    {
        await workspace.ReleaseAsync("dispose");
        await module.ReleaseAsync();
    }
}
