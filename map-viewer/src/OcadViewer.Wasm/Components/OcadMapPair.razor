@using OcadViewer.Loading
@using OcadViewer.Wasm.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Two synced Leaflet maps. Blazor owns the page and the state; JavaScript owns
    the viewport, the file reading and the renderer behind them. This component
    says which version belongs on which side and learns what the parser found;
    map bytes never pass through .NET at all.
*@

@*
    The same grid as Angular's ocad-map-viewer: two columns with a hair of gutter,
    each map 80vh on white. The captions the spike used are gone - the comparison
    header above already names both sides, which is where Angular says it.
*@
<div class="row g-1">
    <div class="col-sm-6">
        <div @ref="leftEl" class="mapDiv"></div>
    </div>
    <div class="col-sm-6">
        <div @ref="rightEl" class="mapDiv"></div>
    </div>
</div>

@code {
    private ElementReference leftEl;
    private ElementReference rightEl;
    private IJSObjectReference module;
    private IJSObjectReference workspace;
    private DotNetObjectReference<OcadMapPair> self;

    /// <summary>
    /// Told how far a load has got, as the browser gets there.
    /// </summary>
    /// <remarks>
    /// Facts, not a percentage: what a piece of work is worth against the rest is
    /// <see cref="LoadPlan"/>'s judgement, and this component has no business
    /// having a second opinion about it.
    /// </remarks>
    [Parameter] public EventCallback<LoadReport> OnProgress { get; set; }

    /// <summary>One map to put on one side.</summary>
    /// <param name="Reload">
    /// Whether the file must be re-read even if that version is already parsed.
    /// True for the working file, which changes on disk while the app is open.
    /// A release never changes, so showing one that is already in memory costs
    /// nothing - no read, no parse.
    /// </param>
    public sealed record MapRequest(MapSide Side, string VersionName, bool Reload);

    /// <summary>How far a load has got.</summary>
    /// <param name="Generation">
    /// Which load this is about. A report can outlive the load it belongs to,
    /// because a mapper who picks another version supersedes the one in flight.
    /// </param>
    public sealed record LoadReport(
        int Generation, int Step, bool Parsed, int TilesDrawn, int TilesExpected, bool Finished);

    /// <summary>What a load produced, in the order it was asked for.</summary>
    /// <param name="Stale">Whether a later load took over before this one finished.</param>
    public sealed record LoadResult(bool Stale, IReadOnlyList<MapInfo> Maps);

    /// <summary>What the parser reported about one version.</summary>
    public sealed record MapInfo(
        string Key, int Version, double MinX, double MinY, double MaxX, double MaxY,
        double ParseMs, string Georeference);

    /// <summary>
    /// What the change overlay drew, for reporting.
    /// </summary>
    /// <param name="ShownPixels">
    /// How many pixels changed. Counted on the other side of the boundary,
    /// where the mask is, rather than handed over as a tally for the page to
    /// add up.
    /// </param>
    public sealed record ChangeSummary(
        bool Shown, int Width, int Height, double ComputedMs,
        int ShownPixels, int TotalPixels);

    /// <summary>A rectangle of the map, in paper millimetres.</summary>
    public sealed record PaperArea(double MinX, double MinY, double MaxX, double MaxY);

    /// <summary>
    /// Importing the module and building the workspace. Held as a task rather than
    /// a flag because a caller can arrive before it has finished.
    /// </summary>
    private Task ready;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            ready ??= InitialiseAsync();
    }

    private async Task InitialiseAsync()
    {
        self = DotNetObjectReference.Create(this);
        module = await JS.ImportAsync("./js/mapWorkspace.js");
        workspace = await module.InvokeAsync<IJSObjectReference>("createWorkspace", leftEl, rightEl);
    }

    /// <summary>
    /// What a load will cost, before starting it.
    /// </summary>
    /// <returns>One step per map, in the order given.</returns>
    public async Task<IReadOnlyList<LoadStep>> PlanAsync(IReadOnlyList<MapRequest> maps)
    {
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<IReadOnlyList<LoadStep>>("plan", OnTheWire(maps));
    }

    /// <summary>
    /// Shows a comparison, and waits until it is on screen.
    /// </summary>
    /// <param name="generation">
    /// Which load this is. Starting a later one abandons this at the first point
    /// it can be abandoned, so the version picked last is the one that wins.
    /// </param>
    /// <remarks>
    /// Both maps in one call, because putting a comparison on screen is one wait
    /// and the page should not have to know how many maps that is. It also means
    /// the two sides can be weighed against each other before either starts.
    /// </remarks>
    public async Task<LoadResult> ShowAsync(IReadOnlyList<MapRequest> maps, int generation)
    {
        // The parent can get here before this component's own first render has
        // finished setting up - the renderer does not wait for a child's
        // OnAfterRenderAsync before running the parent's. Starting the work here
        // if it has not started, and awaiting it either way, removes the race
        // rather than reporting it as "not initialised yet", which is what a
        // caller doing nothing wrong used to see.
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<LoadResult>(
            "show", OnTheWire(maps), self, generation);
    }

    /// <summary>Called from JavaScript as a load gets on with it.</summary>
    [JSInvokable]
    public Task Progress(
        int generation, int step, bool parsed, int tilesDrawn, int tilesExpected, bool finished)
        => OnProgress.InvokeAsync(
            new LoadReport(generation, step, parsed, tilesDrawn, tilesExpected, finished));

    /// <summary>
    /// One map, in the shape JavaScript reads it.
    /// </summary>
    /// <remarks>
    /// The side is a spelled-out name rather than <see cref="MapSide"/> itself,
    /// because Blazor serialises an enum as its ordinal - which would put a bare
    /// 0 and 1 back on the wire and undo the point of the enum having names.
    /// </remarks>
    private sealed record JsRequest(string Side, string VersionName, bool Reload);

    /// <summary>
    /// The requests as one argument.
    /// </summary>
    /// <remarks>
    /// A list and not an array on purpose. Interop takes <c>params object[]</c>,
    /// and C# arrays are covariant, so any array of references is read as the
    /// argument list itself - the two maps then arrive in JavaScript as two
    /// arguments rather than as one array, and the method is handed a request
    /// where it expects a sequence of them.
    /// </remarks>
    private static List<JsRequest> OnTheWire(IReadOnlyList<MapRequest> maps)
        => [.. maps.Select(map => new JsRequest(map.Side.JsName(), map.VersionName, map.Reload))];

    /// <summary>
    /// Shows where two versions differ, as a tinted overlay on the newer one.
    /// </summary>
    /// <remarks>
    /// The mask costs two whole-map renders, so it is computed once per
    /// comparison and kept, image and all - turning the overlay off and on
    /// again is free.
    /// </remarks>
    public async Task<ChangeSummary> ShowChangesAsync(
        string olderVersion, string newerVersion, bool show)
    {
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<ChangeSummary>(
            "showChanges", olderVersion, newerVersion, show);
    }

    /// <summary>
    /// Moves both panes to frame everything the overlay is currently showing.
    /// </summary>
    /// <returns>The framed rectangle, or null if nothing is shown.</returns>
    public async Task<PaperArea> ZoomToChangesAsync()
    {
        if (workspace is null)
            return null;

        return await workspace.InvokeAsync<PaperArea>("zoomToChanges");
    }

    public async ValueTask DisposeAsync()
    {
        await workspace.ReleaseAsync("dispose");
        await module.ReleaseAsync();
        self?.Dispose();
    }
}
