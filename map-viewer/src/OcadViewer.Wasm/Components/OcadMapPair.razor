@using OcadViewer.Versioning
@using OcadViewer.Wasm.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Two synced Leaflet maps. Blazor owns the page and the state; JavaScript owns
    the viewport, the file reading and the renderer behind them. This component
    says which version belongs on which side, and where its file is, and learns
    what the parser found; map bytes never pass through .NET at all.
*@

@*
    The same grid as Angular's ocad-map-viewer: two columns with a hair of gutter,
    each map 80vh on white. The comparison header above names both sides, which
    is where Angular says it.
*@
@*
    Both panes are always on the page, even when only one is shown: Leaflet and
    leaflet.sync are built over two elements once, and a hidden pane keeps its
    map, so showing it again costs nothing and loses nothing.
*@
<div class="row g-1 mapPair @(Fill ? "fill" : "") @(OnlySide is null ? "" : "single")">
    <div class="@ColumnClass" hidden="@(OnlySide == MapSide.Right)">
        @if (LeftTitle is not null) {
            <div class="mapTitle">@LeftTitle</div>
        }
        <div class="mapPane">
            <div @ref="leftEl" class="mapDiv"></div>
            @PaneContent?.Invoke(MapSide.Left)
        </div>
    </div>
    <div class="@ColumnClass" hidden="@(OnlySide == MapSide.Left)">
        @if (RightTitle is not null) {
            <div class="mapTitle">@RightTitle</div>
        }
        <div class="mapPane">
            <div @ref="rightEl" class="mapDiv"></div>
            @PaneContent?.Invoke(MapSide.Right)
        </div>
    </div>
</div>

@code {
    private ElementReference leftEl;
    private ElementReference rightEl;
    private IJSObjectReference module;
    private IJSObjectReference workspace;

    /// <summary>
    /// Show this pane only, or both when null. The other keeps its map, hidden,
    /// for when the page asks for both again.
    /// </summary>
    [Parameter] public MapSide? OnlySide { get; set; }

    /// <summary>
    /// Fill the parent's height instead of the fixed height the workspace uses:
    /// half each when the panes stack on a narrow screen, all of it when they
    /// sit side by side or only one is shown.
    /// </summary>
    [Parameter] public bool Fill { get; set; }

    /// <summary>
    /// Anything the page wants inside a pane, over its map - such as a way to
    /// choose the file shown there. Rendered as a sibling of the map element,
    /// inside the pane, so it can be positioned against the pane.
    /// </summary>
    [Parameter] public RenderFragment<MapSide> PaneContent { get; set; }

    /// <summary>
    /// What is shown centred above each map - a name, or a way to choose the
    /// version - or nothing when null. Above rather than in the pane, so it never
    /// covers the map, and per pane, so it stays over its own map when the panes
    /// stack on a narrow screen.
    /// </summary>
    [Parameter] public RenderFragment LeftTitle { get; set; }

    /// <inheritdoc cref="LeftTitle"/>
    [Parameter] public RenderFragment RightTitle { get; set; }

    private string ColumnClass => OnlySide is null ? "col-sm-6" : "col-12";

    /// <summary>
    /// What the change overlay drew, for reporting.
    /// </summary>
    /// <param name="ShownPixels">
    /// How many pixels changed, counted in JavaScript where the mask is.
    /// </param>
    public sealed record ChangeSummary(
        bool Shown, int Width, int Height, double ComputedMs,
        int ShownPixels, int TotalPixels);

    /// <summary>
    /// Importing the module and building the workspace. Held as a task rather than
    /// a flag because a caller can arrive before it has finished.
    /// </summary>
    private Task ready;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            ready ??= InitialiseAsync();
    }

    private async Task InitialiseAsync()
    {
        module = await JS.ImportAsync("./js/mapWorkspace.js");
        workspace = await module.InvokeAsync<IJSObjectReference>("createWorkspace", leftEl, rightEl);
    }

    /// <summary>
    /// Makes sure a version is parsed, reading its file only if it has to.
    /// </summary>
    /// <param name="source">
    /// Which version, where its file is, and whether it must be read again even
    /// if it is already parsed. A release never changes, so one that is already
    /// in memory costs no read and no parse.
    /// </param>
    /// <remarks>
    /// Separate from <see cref="DrawAsync"/> so the page can say which of the two
    /// is happening, and can stop between them if the mapper has moved on.
    /// </remarks>
    public async Task<MapSummary> ParseAsync(MapSource source)
    {
        // The parent can get here before this component's own first render has
        // finished setting up - the renderer does not wait for a child's
        // OnAfterRenderAsync before running the parent's. Starting the work here
        // if it has not started, and awaiting it either way, removes the race.
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<MapSummary>(
            "parse", source.Name, source.Path, source.Reload);
    }

    /// <summary>
    /// Puts a parsed version in a pane, and waits until the pane has drawn it -
    /// or until another map takes the pane, which drops the tiles it was
    /// waiting for.
    /// </summary>
    public async Task DrawAsync(MapSide side, string versionName)
    {
        await (ready ??= InitialiseAsync());
        await workspace.InvokeVoidAsync("draw", side.JsName(), versionName);
    }

    /// <summary>
    /// Shows the file chosen in a file input on one side.
    /// </summary>
    /// <param name="mapName">What to hold the map under. Read again every time.</param>
    /// <param name="input">
    /// The <c>&lt;input type="file"&gt;</c> holding the file. The element, not the
    /// file, crosses the boundary: the bytes go from the browser to the renderer
    /// without passing through .NET.
    /// </param>
    public async Task<MapSummary> ShowFileAsync(MapSide side, string mapName, ElementReference input)
    {
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<MapSummary>("showFile", side.JsName(), mapName, input);
    }

    /// <summary>
    /// Shows where two versions differ, as a tinted overlay on the newer one.
    /// </summary>
    /// <remarks>
    /// The mask costs two whole-map renders, so it is computed once per
    /// comparison and kept, image and all - turning the overlay off and on
    /// again is free.
    /// </remarks>
    public async Task<ChangeSummary> ShowChangesAsync(
        string olderVersion, string newerVersion, bool show)
    {
        await (ready ??= InitialiseAsync());

        return await workspace.InvokeAsync<ChangeSummary>(
            "showChanges", olderVersion, newerVersion, show);
    }

    /// <summary>
    /// Shows or hides the newer map, so the change overlay painted on it can be
    /// seen on its own. The other pane's map is always shown.
    /// </summary>
    /// <param name="newer">The name the newer map is held under; its pane is found by name.</param>
    public async Task SetMapVisibleAsync(string newer, bool visible)
    {
        await (ready ??= InitialiseAsync());
        await workspace.InvokeVoidAsync("setMapVisible", newer, visible);
    }

    /// <summary>
    /// Forgets every parsed map and change mask, because a different project
    /// folder is about to be shown.
    /// </summary>
    /// <remarks>
    /// Maps are held by version name, and every project has a "V1".
    /// </remarks>
    public async Task ResetAsync()
    {
        await (ready ??= InitialiseAsync());
        await workspace.InvokeVoidAsync("reset");
    }

    public async ValueTask DisposeAsync()
    {
        await workspace.ReleaseAsync("dispose");
        await module.ReleaseAsync();
    }
}
