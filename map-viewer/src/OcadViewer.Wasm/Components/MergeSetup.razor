@using Microsoft.AspNetCore.Components.Forms
@using OcadViewer.Merge.Format
@using OcadViewer.Merge.Matching
@using OcadViewer.Versioning
@using OcadViewer.Wasm.Services
@inherits LocalisedComponent

@*
    The merge's start screen (board 0 of the design): pick the base and the two
    edited copies, name the copies, see whether the three belong together.
*@
<div class="merge-setup">
    <h1 class="h3">@L["#_mergeTitle"]</h1>
    <p class="text-muted">@L["#_mergeIntro"]</p>

    <div class="merge-cards">
        @foreach (MergeRole role in Enum.GetValues<MergeRole>()) {
            MergeInput input = inputs.GetValueOrDefault(role);
            <section class="merge-card role-@role.ToString().ToLowerInvariant()">
                <h2 class="merge-card-title">@RoleName(role)</h2>

                @if (role != MergeRole.Base) {
                    <label class="form-label small mb-1" for="label-@role">@L["#_mergeBranchName"]</label>
                    <input id="label-@role" class="form-control form-control-sm mb-2" value="@labels[role]"
                           @onchange="e => labels[role] = (string)e.Value" />
                }

                <InputFile class="form-control form-control-sm" accept="@FolderLayout.MapExtension" OnChange="e => Pick(role, e)" disabled="@Busy" />

                @if (input is not null) {
                    <div class="merge-file mt-2">
                        <strong>@input.FileName</strong>
                        <span class="text-muted small">
                            @L.Format("#_mergeFileSummary", ("version", input.File.Version),
                                      ("objects", input.File.Objects.Count), ("symbols", input.File.Symbols.Count))
                        </span>
                    </div>
                }
                @if (errors.TryGetValue(role, out string error)) {
                    <p class="text-danger small mt-2 mb-0">@error</p>
                }
            </section>
        }
    </div>

    <section class="merge-checks">
        <h2 class="merge-card-title">@L["#_mergeChecks"]</h2>
        @foreach ((bool ok, string text) in Checks()) {
            <div class="merge-check @(ok ? "ok" : "warn")">
                <i class="bi @(ok ? "bi-check-circle" : "bi-exclamation-triangle")" aria-hidden="true"></i>
                <span>@text</span>
            </div>
        }
    </section>

    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-primary" disabled="@(!CanStart)" @onclick="Start">@L["#_mergeStart"]</button>
    </div>
</div>

@code {
    /// <summary>The three files and the copies' names, once the user starts.</summary>
    [Parameter] public EventCallback<MergeStart> OnStart { get; set; }

    /// <summary>Large maps are ~10 MB; this leaves plenty of room.</summary>
    private const long MaxFileSize = 512L * 1024 * 1024;

    private readonly Dictionary<MergeRole, MergeInput> inputs = [];
    private readonly Dictionary<MergeRole, string> labels = new() { [MergeRole.A] = "", [MergeRole.B] = "" };
    private readonly Dictionary<MergeRole, string> errors = [];
    private bool Busy;

    private bool HaveAll => inputs.Count == 3;

    private bool SameVersion => HaveAll && inputs.Values.Select(i => i.File.Version).Distinct().Count() == 1;

    private bool CanStart => SameVersion && !Busy;

    private async Task Pick(MergeRole role, InputFileChangeEventArgs e)
    {
        Busy = true;
        errors.Remove(role);
        try {
            using MemoryStream copy = new();
            await using (Stream stream = e.File.OpenReadStream(MaxFileSize))
                await stream.CopyToAsync(copy);

            MergeInput input = MergeInput.Read(e.File.Name, copy.ToArray());
            inputs[role] = input;
            if (role != MergeRole.Base && string.IsNullOrWhiteSpace(labels[role]))
                labels[role] = input.DefaultLabel;
        }
        catch (Exception ex) when (ex is OcadFormatException or IOException) {
            inputs.Remove(role);
            errors[role] = L.Format("#_mergeReadFailed", ("file", e.File.Name), ("error", ex.Message));
        }
        finally {
            Busy = false;
        }
    }

    private IEnumerable<(bool Ok, string Text)> Checks()
    {
        if (!HaveAll) {
            yield return (false, L["#_mergeWaitingForFiles"]);
            yield break;
        }

        if (!SameVersion) {
            yield return (false, L["#_mergeDifferentVersions"]);
            yield break;
        }

        yield return (true, L.Format("#_mergeSameVersion", ("version", inputs[MergeRole.Base].File.Version)));
        foreach (MergeRole role in new[] { MergeRole.A, MergeRole.B }) {
            int percent = SharedPercent(inputs[MergeRole.Base].File, inputs[role].File);
            string name = Label(role);
            yield return percent >= 50
                ? (true, L.Format("#_mergeDescends", ("name", name), ("percent", percent)))
                : (false, L.Format("#_mergeDescendsWarning", ("name", name)));
        }
    }

    /// <summary>How much of base a copy still contains: a copy of the right base shares most of it.</summary>
    private static int SharedPercent(OcadFile @base, OcadFile copy)
        => @base.Objects.Count == 0
            ? 100
            : (int)Math.Round(100.0 * ObjectMatcher.Match(@base.Objects, copy.Objects).Pairs.Count / @base.Objects.Count);

    private string Label(MergeRole role)
        => string.IsNullOrWhiteSpace(labels[role]) ? inputs[role].DefaultLabel : labels[role].Trim();

    private string RoleName(MergeRole role) => role switch {
        MergeRole.Base => L["#_mergeBase"],
        MergeRole.A => L["#_mergeFirstBranch"],
        _ => L["#_mergeSecondBranch"],
    };

    private Task Start()
        => OnStart.InvokeAsync(new MergeStart(inputs[MergeRole.Base], inputs[MergeRole.A], inputs[MergeRole.B],
                                              Label(MergeRole.A), Label(MergeRole.B)));
}
