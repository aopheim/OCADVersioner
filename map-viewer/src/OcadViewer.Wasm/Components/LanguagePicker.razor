@using OcadViewer.Wasm.Services
@inherits LocalisedComponent

@*
    A row of flags, one per Localiser.Languages, with the selected one outlined in
    green. Shared by the settings modal, which holds the choice as a draft until
    Save, and the start dialog, which applies it at once. The layout classes are
    parameters because the settings modal lays the flags out on its grid while the
    start dialog fits them into its header.
*@

@* Buttons rather than clickable boxes, so the flags can be reached and pressed
   from the keyboard and are announced as a choice. That matters most in the
   start dialog, which cannot be closed: a user who cannot read it has no other
   way to the language. The wrapper keeps the layout class, so a grid column's
   gutter stays outside the outlined flag. *@
<div class="@Class" role="group" aria-label="@L["#_language"]">
    @foreach (var language in Localiser.Languages) {
        <div class="@ItemClass">
            <button type="button" @onclick="() => Select(language.Code)" data-testid="@($"language-{language.Code}")"
                    class="d-block w-100 p-0 bg-transparent pointer border @(Selected == language.Code ? "border-4 border-success" : "")"
                    title="@language.Name" aria-label="@language.Name"
                    aria-pressed="@(Selected == language.Code ? "true" : "false")">
                <LanguageFlag Code="@language.Code" aria-hidden="true" class="d-block" />
            </button>
        </div>
    }
</div>

@code {
    /// <summary>The language code shown as selected.</summary>
    [Parameter] public string Selected { get; set; }

    [Parameter] public EventCallback<string> SelectedChanged { get; set; }

    /// <summary>Classes on the container.</summary>
    [Parameter] public string Class { get; set; } = "row";

    /// <summary>Classes on each flag's wrapper.</summary>
    [Parameter] public string ItemClass { get; set; } = "col-1";

    private Task Select(string code) =>
        code == Selected ? Task.CompletedTask : SelectedChanged.InvokeAsync(code);
}
