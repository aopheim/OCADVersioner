@using OcadViewer.Loading

@*
    A 2 px bar, present only while something is happening, as in the Angular app -
    but pinned to the window rather than sitting at the top of the page. The
    slowest thing the app does is write a version, and that form is far enough
    down that an in-flow bar had scrolled out of sight by the time it mattered.

    Its own component so that a tile landing redraws this and nothing else. The
    page holds the diff table, which can be thousands of rows, and re-rendering it
    once per tile put that work on the same thread that draws the tiles - the bar
    slowing down the very load it was measuring.
*@
<div class="loadStrip">
    @if (Busy) {
        <div class="progress">
            @if (Plan is { HasWork: true }) {
                <div class="progress-bar" style="width:@shownPercent%"></div>
            } else {
                @* Work whose size cannot be known in advance - the overlay, a
                   rescan, writing a version - keeps the stripe that admits it. *@
                <div class="progress-bar progress-bar-striped progress-bar-animated"
                     style="width:100%"></div>
            }
        </div>
    }

    @if (shownMessage is not null) {
        <div class="loadMessage @(Failed ? "text-danger" : "text-muted")">@shownMessage</div>
    }
</div>

@code {
    [Parameter] public bool Busy { get; set; }

    [Parameter] public bool Failed { get; set; }

    /// <summary>What the page says it is doing, or the error it ran into.</summary>
    [Parameter] public string Status { get; set; }

    /// <summary>
    /// The load under way, or null when what is running has no size anyone can
    /// know in advance. Updated in place as the load goes on; see <see cref="Refresh"/>.
    /// </summary>
    [Parameter] public LoadPlan Plan { get; set; }

    /// <summary>What each step of <see cref="Plan"/> is called on screen, in order.</summary>
    [Parameter] public IReadOnlyList<string> StepNames { get; set; } = [];

    private int shownPercent;
    private string shownMessage;

    protected override void OnParametersSet() => (shownPercent, shownMessage) = Measure();

    /// <summary>
    /// Brings the bar up to date with a plan that has moved on.
    /// </summary>
    /// <remarks>
    /// Redraws only when what is on screen would change. A width rounded to the
    /// whole percent, and a message that changes once per map, mean most tiles
    /// cost nothing at all here.
    /// </remarks>
    public void Refresh()
    {
        (int percent, string message) = Measure();
        if (percent == shownPercent && message == shownMessage)
            return;

        (shownPercent, shownMessage) = (percent, message);
        StateHasChanged();
    }

    private (int Percent, string Message) Measure()
        => (Plan is null ? 0 : (int)Math.Round(Plan.Fraction * 100), Message());

    /// <summary>
    /// What the load is doing, in the names a mapper uses for these maps.
    /// </summary>
    /// <remarks>
    /// Reading and parsing cannot be told apart from outside - the read is one
    /// await and the parse one blocking call - so they are one word. Drawing is
    /// worth naming separately because it is the half where the map appears.
    /// An error, or a step past the last, says what the page said.
    /// </remarks>
    private string Message()
    {
        if (Failed || Plan is null || Plan.Step >= StepNames.Count)
            return Status;

        string name = StepNames[Plan.Step];
        return Plan.IsDrawing ? $"Drawing {name}…" : $"Loading {name}…";
    }
}
