@* A 2 px bar, present only while something is happening, as in the Angular app.
   The space is kept when idle so the page does not jump. Striped when the work
   cannot say how far it is; filled to Progress when it can. *@
<div style="height:2px">
    @if (Busy) {
        <div class="progress" style="height:2px">
            @if (Progress is double done) {
                <div class="progress-bar" style="width:@((int)Math.Round(done * 100))%"></div>
            } else {
                <div class="progress-bar progress-bar-striped progress-bar-animated"
                     style="width:100%"></div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool Busy { get; set; }

    /// <summary>How far the work is, 0 to 1, or null when it cannot say.</summary>
    [Parameter] public double? Progress { get; set; }
}
