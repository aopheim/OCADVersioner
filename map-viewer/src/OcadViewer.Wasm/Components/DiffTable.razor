@using OcadViewer.Diff
@using OcadViewer.Wasm.Services
@inherits LocalisedComponent

@*
    Tabs and table, mirroring Angular's diff-table-tabs and ocad-diff-table. The
    columns differ by tab: added and deleted symbols report size, updated ones
    report how much they changed.
*@

<ul class="nav nav-tabs nav-fill mt-3">
    @foreach (var view in Views) {
        <li class="nav-item">
            <button type="button"
                    class="nav-link @(view == Current ? "active" : "")"
                    @onclick="() => SetView(view)">
                @L[LabelKey(view)]
                @if (Diff.Count(view) > 0) {
                    <span class="mx-2 badge text-bg-secondary">@Diff.Count(view)</span>
                }
            </button>
        </li>
    }
</ul>

@if (!Available) {
    <div class="alert alert-secondary mt-3 mb-0">@L[UnavailableReasonKey ?? "#_nothingToShow"]</div>
}

<div class="table-responsive mt-3">
    <table class="table table-sm table-striped table-hover">
        <thead>
            <tr>
                <th scope="col"><span class="visually-hidden">@L["#_zoomToObject"]</span></th>
                <th scope="col">@L["#_symbolNumber"]</th>
                <th scope="col">@L["#_symbolName"]</th>
                @if (Current is DiffTableView.Added or DiffTableView.Deleted) {
                    <th scope="col">@L["#_lengthInMeters"]</th>
                    <th scope="col">@L["#_areaInSquareMeters"]</th>
                }
                else {
                    <th scope="col">@L["#_movedNumberOfMeters"]</th>
                    <th scope="col">@L["#_percentageLengthDiff"]</th>
                    <th scope="col">@L["#_percentageAreaDiff"]</th>
                    <th scope="col">@L["#_changes"]</th>
                }
                <th scope="col">@L["#_createdAt"]</th>
                <th scope="col">@L["#_lastEditedAt"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Rows().Count == 0) {
                <tr>
                    <td colspan="9" class="text-center text-muted py-3">
                        @L[Available ? "#_noSymbolsInCategory" : "#_nothingToShow"]
                    </td>
                </tr>
            }
            @foreach (var symbol in Rows()) {
                @* data-bounds is the same rectangle the button zooms to, readable from the
                   console - which is how the table was checked against the change overlay. *@
                <tr data-bounds="@BoundsAttribute(symbol.Bounds)">
                    <td class="py-0 align-middle">
                        <button type="button" class="btn btn-link btn-sm p-0"
                                title="@L["#_zoomToObject"]" aria-label="@L["#_zoomToObject"]"
                                disabled="@(symbol.Bounds is null)"
                                @onclick="() => OnZoom.InvokeAsync(symbol.Bounds)">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                    </td>
                    <th scope="row">@symbol.SymbolNumber</th>
                    <td>@symbol.SymbolName</td>

                    @if (symbol is AddedSymbol added) {
                        <td>@Metres(added.LengthInMeters)</td>
                        <td>@SquareMetres(added.AreaInSquareMeters)</td>
                    }
                    else if (symbol is DeletedSymbol deleted) {
                        <td>@Metres(deleted.LengthInMeters)</td>
                        <td>@SquareMetres(deleted.AreaInSquareMeters)</td>
                    }
                    else if (symbol is UpdatedSymbol updated) {
                        <td>@Metres(updated.MovementInMeters)</td>
                        <td>@Percent(updated.LengthDiffInPercent)</td>
                        <td>@Percent(updated.AreaDiffInPercent)</td>
                        <td>@ChangeNames(updated.Changes)</td>
                    }

                    <td>@Date(symbol.CreatedAtUtc)</td>
                    <td>@Date(symbol.LastEditedAtUtc)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private static readonly DiffTableView[] Views =
        [DiffTableView.Added, DiffTableView.Updated, DiffTableView.Deleted];

    [Parameter, EditorRequired] public MapDiff Diff { get; set; } = MapDiff.Empty;
    [Parameter] public bool Available { get; set; }
    [Parameter] public string UnavailableReasonKey { get; set; }

    /// <summary>Asks the page to frame one object on both maps.</summary>
    [Parameter] public EventCallback<PaperBounds> OnZoom { get; set; }

    private DiffTableView Current { get; set; } = DiffTableView.Added;

    private void SetView(DiffTableView view) => Current = view;

    private static string LabelKey(DiffTableView view) => view switch {
        DiffTableView.Added => "#_added",
        DiffTableView.Updated => "#_edited",
        DiffTableView.Deleted => "#_deleted",
        _ => view.ToString()
    };

    private IReadOnlyList<DiffSymbol> Rows() => Current switch {
        DiffTableView.Added => Diff.Added,
        DiffTableView.Updated => Diff.Updated,
        DiffTableView.Deleted => Diff.Deleted,
        _ => []
    };

    // Blank rather than "0" when a measure does not apply to this symbol kind -
    // a zero length on a point symbol would read as a measurement, not an absence.
    private string Metres(double? value) => value is null ? "" : $"{value:N0} {L["#_mAbbreviation"]}";
    private string SquareMetres(double? value) => value is null ? "" : $"{value:N0} {L["#_m2Abbreviation"]}";
    private static string Percent(double? value) => value is null ? "" : $"{value:N1} %";

    private static readonly (ObjectChanges Change, string Key)[] ChangeKeys = [
        (ObjectChanges.Symbol, "#_changeSymbol"),
        (ObjectChanges.Geometry, "#_changeGeometry"),
        (ObjectChanges.Angle, "#_changeAngle"),
        (ObjectChanges.Text, "#_changeText"),
    ];

    private string ChangeNames(ObjectChanges changes)
        => string.Join(", ", ChangeKeys.Where(c => changes.HasFlag(c.Change)).Select(c => L[c.Key]));

    private static string BoundsAttribute(PaperBounds b)
        => b is null ? null : FormattableString.Invariant($"{b.MinX},{b.MinY},{b.MaxX},{b.MaxY}");

    private static string Date(DateTimeOffset? value)
        => value is null ? "" : value.Value.ToLocalTime().ToString("g");
}
