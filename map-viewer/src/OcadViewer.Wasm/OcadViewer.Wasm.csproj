<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- The Blazor template generates nullable annotations in NavMenu regardless
         of this setting; the warning is about generated code, not ours. -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- Saves roughly 1.4 MB of ICU data. Safe for this stack: the vendored code
         formats with CultureInfo.InvariantCulture throughout, and the legacy OCAD
         6-8 codepage support comes from CodePagesEncodingProvider, which carries
         its own tables and does not depend on ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Measured, not assumed. AOT makes parsing large_map.ocd 16x faster
         (6200 ms -> 381 ms) and tiles 3.3-4.4x faster, because the cost is
         managed work in SymDef/SymPath rather than Skia rasterisation. It costs
         about 3 MB brotli and roughly an hour of publish time. Worth it.

         This only applies to publish, so dev builds stay fast. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>

    <BlazorEnableCompression>true</BlazorEnableCompression>

    <!-- The tile layer needs JS to call .NET for pixels. [JSExport] marshals byte[]
         as a real typed array; the DotNetObjectReference route would serialise it
         as base64 inside JSON, which at 256 KB a tile is not viable. -->
    <WasmEnableJSExports>true</WasmEnableJSExports>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.Views.Blazor" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcadViewer.Core\OcadViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Neither assembly was written with IL trimming in mind: MapModel resolves
         an embedded resource by hardcoded name and DotSpatial carries .resx data.
         Root them until the Stage-1 map corpus has been run through the browser
         with the roots removed, so trimming bugs surface as a deliberate test
         rather than as a runtime failure on someone's map. -->
    <TrimmerRootAssembly Include="MapModel" />
    <TrimmerRootAssembly Include="DotSpatial.Projections" />
  </ItemGroup>


  <!-- Stage the vendored fonts into wwwroot so the static web asset pipeline
       serves them. A Content item with Link metadata is NOT enough: the file
       lands in the output directory but is never registered as a static web
       asset, so requests for it return an empty 200 and the app silently ends
       up with zero-byte fonts. wwwroot/fonts is generated and git-ignored. -->
  <Target Name="StageVendorFonts" BeforeTargets="ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <VendorFont Include="$(VendorDir)fonts\*.ttf" />
    </ItemGroup>
    <Copy SourceFiles="@(VendorFont)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\fonts"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
