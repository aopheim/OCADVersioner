@page "/"
@using OcadViewer.Versioning
@using OcadViewer.Wasm.Components
@using OcadViewer.Wasm.Services
@inherits BusyPage
@inject ProjectService Project
@inject IDiffSource DiffSource

<PageTitle>@L["#_OCADVersioner"]</PageTitle>

@*
    container-fluid lives here rather than in the layout because that is where the
    Angular app puts it: there is no shell, every page is its own container.
*@
<div class="container-fluid">

<BusyBar Busy="Busy" Progress="Progress" />

<div class="d-flex justify-content-between align-items-center">
    <h3 class="my-2">@L["#_OCADVersioner"]</h3>
    <div>
        <a href="about" target="_blank" title="@L["#_about"]">
            <i class="bi bi-book cursorPointer mx-3 h4 noColor"></i>
        </a>
        @* Opened by Bootstrap itself, as in the Angular app, rather than by a
           Blazor flag - that is what gets the backdrop and the escape key. *@
        <i class="bi bi-sliders cursorPointer mx-3 h4" title="@L["#_settings"]"
           data-bs-toggle="modal" data-bs-target="#appSettingsModal"></i>
    </div>
</div>

@* The start page. It opens itself and owns choosing the folder, the working file
   and reporting why either failed - so none of that is duplicated here. *@
<ProjectDirectorySelector @ref="selector" OnProjectLoaded="OnProjectLoaded" />

@if (Project.IsOpen) {
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <span class="text-muted small">
            @Project.Project.ProjectName
            @if (!string.IsNullOrEmpty(Project.Project.CurrentFileName)) {
                <text> / @Project.Project.CurrentFileName</text>
            }
        </span>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh" disabled="@Busy"
                title="@L["#_rereadFolder"]">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ChangeProject" disabled="@Busy"
                title="@L["#_chooseOcadDirectory"]">
            <i class="bi bi-folder2-open"></i>
        </button>

        @* The change overlay, off on arrival because building it means rendering
           both maps in full. *@
        <div class="vr mx-1"></div>
        <ChangeOverlayToggle @ref="overlay" MapPair="mapPair"
                             Older="@Comparison.Older" Newer="@Comparison.Newer"
                             Busy="Busy" Run="Run" />

        @* Progress goes in this row, not on a line of its own: a line that comes
           and goes pushes the maps down and back up each time, under the mouse. *@
        @if (StatusInToolbar) {
            <span class="text-muted small">@Status</span>
        }
    </div>
}

@if (Status is not null && !StatusInToolbar) {
    <p class="@(Failed ? "text-danger" : "text-muted")">@Status</p>
}

@if (Project.IsOpen) {
    <div class="row">
        <div class="col-md-2 d-flex flex-column">
            <VersionList Items="VersionItems()" SelectedNumber="selectedNumber"
                         Disabled="Blocked" OnSelected="SelectVersion" />

            @* Shown only while the working file is on screen, as in the Angular
               app: a new version is always a copy of the working file, so offering
               it beside two past versions would suggest it copies one of them.
               Hidden rather than removed, so a title and description typed before
               a look at an older version are still there on the way back. *@
            @if (!string.IsNullOrEmpty(Project.Project.CurrentFileName)) {
                <div class="mt-auto" hidden="@IsHistory">
                    <CreateVersionForm @ref="versionForm"
                                       FileName="@Project.Project.CurrentFileName"
                                       NextVersionName="@Project.NextVersionName()"
                                       Busy="Busy"
                                       OnCreate="CreateVersion" />
                </div>
            }
        </div>

        <div class="col-md-10">
            <div class="d-flex justify-content-center align-items-center gap-3 mb-1">
                @if (IsHistory) {
                    <i class="bi bi-book fs-4 text-primary" title="@L["#_comparingPastVersions"]"></i>
                }
                @* In the order the maps are in, so a glance at the heading and a
                   glance at the panes agree. *@
                <span class="fw-medium">@Label(Comparison.Older)</span>
                <i class="bi bi-arrows"></i>
                <span class="fw-medium">@Label(Comparison.Newer)</span>
            </div>

            <OcadMapPair @ref="mapPair" />

            <DiffTable Diff="diff" Available="DiffSource.IsAvailable"
                       UnavailableReasonKey="@DiffSource.UnavailableReasonKey" />
        </div>
    </div>
}

<SettingsDialog Georeference="@georeference" />

</div>

@code {
    private OcadMapPair mapPair;
    private ProjectDirectorySelector selector;
    private CreateVersionForm versionForm;

    /// <summary>Set when a project has just opened and the maps still need loading.</summary>
    private bool comparisonPending;

    private MapDiff diff = MapDiff.Empty;
    private string georeference;

    /// <summary>
    /// Which load is the current one. Each <see cref="ShowComparison"/> takes the
    /// next number; an older one checks after every wait and stops quietly once
    /// a newer one has started.
    /// </summary>
    private int loadGeneration;

    /// <summary>Which version is being compared, 0 meaning the working file.</summary>
    private int selectedNumber;

    private ChangeOverlayToggle overlay;

    /// <summary>
    /// Progress shows in the toolbar once a project is open. Failures keep their own
    /// line, because they stay until dismissed by the next action and should be seen.
    /// </summary>
    private bool StatusInToolbar => Status is not null && !Failed && Project.IsOpen;

    /// <summary>
    /// The two sides of the current comparison. Which version sits opposite which
    /// is a rule about project folders, not about this page, so it is answered by
    /// <see cref="ProjectService"/> - and tested without a browser.
    /// </summary>
    private (string Newer, string Older) Comparison => Project.ComparisonFor(selectedNumber);

    /// <summary>True when looking at two past versions rather than the working file.</summary>
    private bool IsHistory => selectedNumber != 0;

    /// <summary>
    /// The released versions, newest first.
    /// </summary>
    /// <remarks>
    /// The working file is not one of them. It is the map OCAD is writing, not a
    /// version of anything, and listing it among the releases would make the
    /// newest release look like the second newest thing in the project.
    /// </remarks>
    private IReadOnlyList<VersionList.Item> VersionItems()
        => [.. Project.Project.Versions
                .OrderByDescending(v => v.Number)
                .Select(v => new VersionList.Item(
                    v.Number, v.Name, v.Metadata.Title, v.Metadata.Description,
                    v.Metadata.VersionCreatedAt,
                    v.Metadata.NumberOfAddedSymbols,
                    v.Metadata.NumberOfEditedSymbols,
                    v.Metadata.NumberOfDeletedSymbols))];

    /// <summary>
    /// What one side of the comparison is called on screen.
    /// </summary>
    /// <remarks>
    /// Releases answer to their own names. The working file has no name a mapper
    /// would recognise - the folder format calls it "current" - so it says what
    /// OCAD has open instead.
    /// </remarks>
    private string Label(string versionName)
        => ProjectService.IsVolatile(versionName)
            ? Project.Project.CurrentFileName ?? versionName
            : versionName;

    /// <summary>
    /// The folder is open and a working file is settled.
    /// </summary>
    /// <remarks>
    /// The maps cannot be loaded here. Until this moment the workspace was not on
    /// the page at all - it renders only once a project is open - so OcadMapPair
    /// does not exist yet and its <c>@@ref</c> is still null. Asking for a render
    /// and picking the work up afterwards is what makes the component available.
    /// </remarks>
    private void OnProjectLoaded()
    {
        selectedNumber = 0;
        overlay?.Reset();
        comparisonPending = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Children render before their parent's OnAfterRenderAsync runs, so by now
        // the map pair exists and has started its own JS module.
        if (!comparisonPending || mapPair is null || Busy)
            return;

        comparisonPending = false;

        // A different folder may have been opened, and its releases share their
        // names with the last one's, so nothing parsed before can be trusted.
        await Run(() => L["#_loading"], async () => {
            await mapPair.ResetAsync();
            await ShowComparison();
        });
    }

    private async Task Refresh()
        => await Run(() => L["#_rereadingFolder"], async () => {
            await Project.RefreshAsync();
            await ShowComparison();
        });

    /// <summary>Reopens the start dialog, to point the app at a different folder.</summary>
    private async Task ChangeProject() => await selector.ShowAsync();

    /// <summary>Looks at a version, or puts the working file back on screen.</summary>
    /// <remarks>
    /// Clicking the version already selected is the way back to the file OCAD is
    /// writing. That file is not in the list - it is not a version - so the row
    /// you left through has to be the way back, or there is none.
    ///
    /// A pick made while the last one is still loading takes over: the mapper
    /// has already moved on, and waiting out a comparison they have left is
    /// time spent on nothing.
    /// </remarks>
    private async Task SelectVersion(int number)
        => await RunTakingOver(() => L["#_loading"], async () => {
            selectedNumber = number == selectedNumber ? 0 : number;
            await ShowComparison();
        });

    private async Task CreateVersion((string Title, string Description) entry)
    {
        // Captured now: once the version exists, the next name is a different one.
        string creating = Project.NextVersionName();

        await Run(() => L.Format("#_creatingNewVersion", ("newVersionName", creating)), async () => {
            await Project.CreateVersionAsync(entry.Title, entry.Description);
            versionForm?.Reset();
            selectedNumber = 0;
            await ShowComparison();
        });
    }

    /// <summary>Puts both sides of the comparison on screen.</summary>
    /// <remarks>
    /// Each side is named, not numbered, and a release is only re-read when it is
    /// not already parsed - so moving from "V4 against V3" to "V3 against V2"
    /// parses V2 alone. Only the working file is reloaded every time, because only
    /// the working file can have changed on disk.
    /// </remarks>
    private async Task ShowComparison()
    {
        // Not a guard against ordinary timing - the caller is responsible for
        // waiting until the workspace has rendered. Silently returning here is how
        // "the folder opened but no maps appeared" would look.
        if (mapPair is null)
            throw new InvalidOperationException("The map pair is not on the page yet.");

        (string newer, string older) = Comparison;
        int mine = ++loadGeneration;
        bool Superseded() => mine != loadGeneration;

        // Older on the left, newer on the right: time runs that way, and the
        // overlay - which is painted on the newer map - then sits where the eye
        // ends up rather than where it starts. The newer map goes first, because
        // it is the one being looked at.
        (MapSide Side, string Version)[] maps = [(MapSide.Right, newer), (MapSide.Left, older)];

        try {
            // The bar moves in equal steps - read, then draw, for each map. Not
            // a measure of time, and it does not need to be: it says the app is
            // working and roughly how much is left.
            for (int i = 0; i < maps.Length; i++) {
                (MapSide side, string version) = maps[i];
                double share = 1.0 / maps.Length;

                Report(() => L.Format("#_loadingMap", ("name", Label(version))), i * share);
                MapSummary info = await mapPair.ParseAsync(Project.SourceFor(version));
                if (Superseded())
                    return;

                if (i == 0)
                    georeference = info.Georeference;

                Report(() => L.Format("#_drawingMap", ("name", Label(version))), (i + 0.5) * share);
                Task drawn = mapPair.DrawAsync(side, version);

                // The diff is read from the parses, not the tiles, so the table
                // can fill while the last pane draws.
                if (i == maps.Length - 1) {
                    diff = await DiffSource.CompareAsync(older, newer);
                    if (Superseded())
                        return;
                    StateHasChanged();
                }

                await drawn;
                if (Superseded())
                    return;
            }

            // The overlay belongs to a pair of versions, so a new comparison needs
            // a new mask. Only paid for if the user has asked to see one - and
            // only once both panes are drawn, because building it renders both
            // maps in full. How long that takes cannot be said, so the bar goes
            // back to striped. The pair is passed in because selectedNumber or the
            // folder has only just changed, and the toggle has not been
            // re-rendered with it yet.
            if (overlay.IsOn)
                Report(() => L["#_findingChanges"], null);

            await overlay.ApplyAsync(older, newer);
        }
        catch when (Superseded()) {
            // The mapper has already moved on; what went wrong with a comparison
            // nobody is waiting for is not worth telling them.
        }
    }
}
