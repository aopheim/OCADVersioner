@page "/merge"
@using OcadViewer.Merge
@using Microsoft.JSInterop
@using OcadViewer.Merge.Analysis
@using OcadViewer.Merge.Decisions
@using OcadViewer.Merge.Regions
@using OcadViewer.Versioning
@using OcadViewer.Wasm.Components
@using OcadViewer.Wasm.Services
@inherits BusyPage
@inject IJSRuntime JS
@inject MergeProgressStore ProgressStore

<PageTitle>@L["#_merge"] · @L["#_OCADVersioner"]</PageTitle>

<div class="container-fluid merge-page">
<BusyBar Busy="Busy" Progress="Progress" />

<header class="merge-header">
    <a class="h5 mb-0 text-decoration-none" href="">@L["#_OCADVersioner"]</a>
    <span class="badge text-bg-dark">@L["#_merge"]</span>
    @if (session is not null) {
        <span class="merge-files">
            <span class="text-muted">@L["#_mergeBaseShort"]</span> <strong>@start.Base.FileName</strong>
            <span class="text-muted">←</span>
            <span class="merge-dot side-a"></span><strong class="text-a">@start.LabelA</strong>
            <span class="text-muted">+</span>
            <span class="merge-dot side-b"></span><strong class="text-b">@start.LabelB</strong>
        </span>
        <span class="flex-grow-1"></span>
        <span class="small text-muted">@ProgressText</span>
        @if (ConflictCount > 0 && !walking) {
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => walking = true" disabled="@Busy">
                @L["#_mergeWalk"] <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </button>
        }
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-secondary" disabled="@(Busy || !session.CanUndo)"
                    @onclick="() => ApplyAsync(s => s.Undo())" title="@L["#_mergeUndo"]">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> @L["#_mergeUndo"]
            </button>
            <button type="button" class="btn btn-outline-secondary" disabled="@(Busy || !session.CanRedo)"
                    @onclick="() => ApplyAsync(s => s.Redo())" title="@L["#_mergeRedo"]">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> @L["#_mergeRedo"]
            </button>
        </div>
        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAsync"
                disabled="@(Busy || !session.Resolution.IsComplete)"
                title="@(session.Resolution.IsComplete ? null : L["#_mergeSaveBlocked"])">
            @L["#_mergeSave"]
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="StartOver" disabled="@Busy">
            @L["#_mergeStartOver"]
        </button>
    }
</header>

@if (Status is not null) {
    <p class="@(Failed ? "text-danger" : "text-muted") mb-1">@Status</p>
} else if (saved is not null) {
    <p class="text-success mb-1">@L.Format("#_mergeSaved", ("file", saved))</p>
}

@if (session is null) {
    <MergeSetup OnStart="Start" />
} else {
    @* The walker exists only while open: its number keys must not decide anything from the map. *@
    @if (walking) {
        <ConflictWalker Session="session" Start="start" Listing="Listing" LabelA="@start.LabelA" LabelB="@start.LabelB"
                        Disabled="Busy" OnChoose="Choose" OnClose="() => walking = false" />
    }
    <div class="merge-body" hidden="@walking">
        <aside class="merge-rail">
            <div class="merge-rail-group">
                <span class="merge-label">@L["#_mergeShowMapAs"]</span>
                <div class="btn-group btn-group-sm flex-wrap" role="group">
                    @foreach ((string key, string name) in Layers) {
                        <button type="button" class="btn @(key == layer ? "btn-dark" : "btn-outline-secondary")"
                                @onclick="() => ShowLayer(key)" disabled="@Busy">@name</button>
                    }
                </div>
            </div>
            <div class="merge-rail-group">
                <label class="merge-label" for="merge-fade">@L["#_mergeFade"]</label>
                <input id="merge-fade" type="range" class="form-range" min="0.1" max="1" step="0.05"
                       value="@fade.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="e => fade = double.Parse((string)e.Value, System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <div class="merge-rail-group merge-legend">
                <span class="merge-label">@L["#_mergeLegend"]</span>
                <span><i class="legend solid"></i>@L["#_added"]</span>
                <span><i class="legend dashed"></i>@L["#_edited"]</span>
                <span><i class="legend dotted"></i>@L["#_deleted"]</span>
                <span><i class="legend conflict"></i>@L["#_mergeConflict"]</span>
            </div>
        </aside>

        <main class="merge-map">
            <MergeMap @ref="map" Fade="fade" OnPick="Select"
                      OnRegionsChanged="RegionsChanged" OnRegionPicked="PickRegion" />
        </main>

        <div class="merge-side">
            <ChangePanel Listing="Listing" LabelA="@start.LabelA" LabelB="@start.LabelB" Disabled="Busy"
                         @bind-Tab="tab" SelectedKey="@selected" OnSelect="SelectAndZoom" RegionCount="regions.Count">
                <RegionsContent>
                    <RegionPanel Session="session" Regions="regions" LabelA="@start.LabelA" LabelB="@start.LabelB"
                                 SelectedId="@selectedRegion" Disabled="Busy" OnDraw="DrawRegion" OnSuggest="SuggestRegions"
                                 OnChoose="Choose" OnRemove="RemoveRegion" OnSelectItem="SelectAndZoom" />
                </RegionsContent>
                <Actions Context="entry">
                    <ChoiceButtons Source="entry.Source" Session="session" LabelA="@start.LabelA" LabelB="@start.LabelB"
                                   Disabled="Busy" OnChoose="Choose" />
                </Actions>
            </ChangePanel>
        </div>
    </div>
}
</div>

@code {
    private const string MergePane = "merge";
    private const string ResultLayer = "result";

    private MergeStart start;
    private MergeSession session;
    private MergeMap map;
    private string layer = ResultLayer;
    private double fade = 0.45;
    private MergeTab tab;
    private string selected;
    private List<MergeRegion> regions = [];
    private string selectedRegion;
    private int suggestions;
    private string saved;
    private bool walking;
    private MergePanelListing listing;

    /// <summary>Completes when the map component has rendered, so the page can draw on it.</summary>
    private TaskCompletionSource<MergeMap> mapRendered = NewMapRendered();

    /// <summary>How long the map component may take to appear before the merge gives up.</summary>
    private static readonly TimeSpan MapTimeout = TimeSpan.FromSeconds(30);

    private IEnumerable<(string Key, string Name)> Layers => [
        (ResultLayer, L["#_mergeResult"]),
        ("base", L["#_mergeBaseShort"]),
        ("a", start.LabelA),
        ("b", start.LabelB),
    ];

    private int ConflictCount => session.Resolution.DecisionsNeeded;

    private string ProgressText
        => L.Format("#_mergeResolvedOf", ("resolved", ConflictCount - session.Resolution.Unresolved.Count), ("total", ConflictCount));

    private Task Start(MergeStart chosen)
        => Run(() => L["#_mergeAnalysing"], async () => {
            start = chosen;
            session = new MergeSession(MergeAnalyzer.Analyze(chosen.Base.File, chosen.A.File, chosen.B.File));
            if (chosen.Resume is MergeProgress resume) {
                session.Restore(resume.Decisions);
                regions = [.. resume.RestoreRegions()];
                suggestions = regions.Count(r => r.Id.StartsWith('s'));
            }
            tab = session.Resolution.Unresolved.Count > 0 ? MergeTab.Conflicts : MergeTab.A;

            Report(() => L["#_mergeDrawing"], null);
            StateHasChanged();
            MergeMap shown = await mapRendered.Task.WaitAsync(MapTimeout);
            await shown.Ready;

            await map.LoadAsync("base", chosen.Base.FileName, chosen.Base.Bytes);
            await map.LoadAsync("a", chosen.A.FileName, chosen.A.Bytes);
            await map.LoadAsync("b", chosen.B.FileName, chosen.B.Bytes);
            await RefreshResultAsync();
            await map.ShowAsync(MergePane, layer);
            if (regions.Count > 0)
                await DescribeRegionsAsync(withRings: true);
        });

    /// <summary>Re-renders the merged map and its outlines after the decisions changed.</summary>
    private async Task RefreshResultAsync()
    {
        await map.LoadAsync(ResultLayer, start.Base.FileName, session.WritePreview(DateTime.Now));
        await map.SetFeaturesAsync(MergePane, MergeOverlay.Json(session));
        if (layer == ResultLayer)
            await map.ShowAsync(MergePane, ResultLayer);
    }

    /// <summary>
    /// The one way the page changes the merge: apply the change, then redraw the
    /// merged map and its outlines to match.
    /// </summary>
    private Task ApplyAsync(Action<MergeSession> change)
        => RunWhenIdle(() => L["#_mergeDrawing"], async () => {
            change(session);
            saved = null;
            await SaveProgressAsync();
            await RefreshResultAsync();
        });

    private Task ShowLayer(string key)
        => Run(() => L["#_mergeDrawing"], async () => {
            layer = key;
            await map.ShowAsync(MergePane, key);
        });

    /// <summary>A pick on the map: select the row, switching to the tab that lists it.</summary>
    private async Task Select(string key)
    {
        selected = key;
        // Stay on the tab if it lists the pick (a shared change is under both copies).
        if (!Listing[tab].Any(e => e.Key == key) && Listing.TabOf(key) is MergeTab holding)
            tab = holding;
        await map.SelectAsync(MergePane, key);
    }

    private async Task SelectAndZoom(string key)
    {
        await Select(key);
        await map.ZoomToAsync(MergePane, key);
    }

    private Task Choose((object Source, Choice? Choice) chosen)
        => ApplyAsync(s => MergeChoices.Apply(s, chosen.Source, chosen.Choice));

    private Task SaveAsync()
        => Run(() => L["#_mergeSaving"], async () => {
            string fileName = $"{Path.GetFileNameWithoutExtension(start.Base.FileName)}-{L["#_mergeMergedSuffix"]}{FolderLayout.MapExtension}";
            byte[] merged = session.Write(DateTime.Now);
            await using IJSObjectReference saver = await JS.ImportAsync("./js/fileSave.js");
            await saver.InvokeVoidAsync("download", fileName, merged);
            saved = fileName;
            // Finished: nothing left to resume.
            await ProgressStore.RemoveAsync(MergeProgress.KeyFor(start));
        });

    private Task DrawRegion(string shape) => map.DrawRegionAsync(MergePane, shape);

    /// <summary>The drawing changed: take the shapes, keep what the screen knows about each.</summary>
    private async Task RegionsChanged(string json)
    {
        regions = MergeRegions.FromShapes(json, regions);
        await DescribeRegionsAsync(withRings: false);
        await SaveProgressAsync();
    }

    private void PickRegion(string id)
    {
        selectedRegion = id;
        tab = MergeTab.Regions;
    }

    private async Task SuggestRegions()
    {
        foreach (MergeRegion old in regions.Where(r => r.Id.StartsWith('s')).ToList())
            await map.RemoveRegionAsync(MergePane, old.Id);

        List<MergeRegion> suggested = [.. RegionSuggester.Suggest(session.Analysis)
            .Select(s => new MergeRegion($"s{++suggestions}", $"S{suggestions}", s.Region, s.Suggested))];
        regions = [.. regions.Where(r => !r.Id.StartsWith('s')), .. suggested];
        await map.DescribeRegionsAsync(MergePane, MergeRegions.Describe(suggested, RegionLabel, withRings: true));
        await SaveProgressAsync();
    }

    private async Task RemoveRegion(MergeRegion region)
    {
        await map.RemoveRegionAsync(MergePane, region.Id);
        regions = [.. regions.Where(r => r.Id != region.Id)];
        await SaveProgressAsync();
    }

    /// <summary>Keeps the decisions and regions in this browser, to resume with the same files.</summary>
    private Task SaveProgressAsync() => ProgressStore.SaveAsync(MergeProgress.Of(start, session, regions));

    private Task DescribeRegionsAsync(bool withRings)
        => map.DescribeRegionsAsync(MergePane, MergeRegions.Describe(regions, RegionLabel, withRings));

    private string RegionLabel(MergeRegion region) => region.Suggested switch {
        Side.A => $"{region.Name} · {start.LabelA}",
        Side.B => $"{region.Name} · {start.LabelB}",
        _ => region.Name,
    };

    private void StartOver()
    {
        session = null;
        start = null;
        saved = null;
        regions = [];
        selectedRegion = null;
        walking = false;
        selected = null;
        layer = ResultLayer;
        listing = null;
        mapRendered = NewMapRendered();
    }

    /// <summary>The side panel's rows, rebuilt only when the decisions or the language changed.</summary>
    private MergePanelListing Listing
        => listing is not null && ReferenceEquals(listing.Resolution, session.Resolution) && listing.Language == L.Language
            ? listing
            : listing = MergePanelEntries.For(session, start.LabelA, start.LabelB, L);

    protected override void OnAfterRender(bool firstRender)
    {
        if (map is not null)
            mapRendered.TrySetResult(map);
    }

    private static TaskCompletionSource<MergeMap> NewMapRendered() => new(TaskCreationOptions.RunContinuationsAsynchronously);

}
