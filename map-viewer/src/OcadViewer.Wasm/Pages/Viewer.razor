@page "/"
@using OcadViewer.Wasm.Components
@using OcadViewer.Wasm.Services
@inject ProjectService Project
@inject IDiffSource DiffSource
@inject Localiser L
@implements IDisposable

<PageTitle>@L["#_OCADVersioner"]</PageTitle>

@* A 2 px bar, present only while something is happening, as in the Angular app. *@
<div style="height:2px">
    @if (busy) {
        <div class="progress" style="height:2px">
            <div class="progress-bar progress-bar-striped progress-bar-animated"
                 style="width:100%"></div>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center">
    <h3 class="my-2">@L["#_OCADVersioner"]</h3>
    <div>
        <a href="about" target="_blank" title="@L["#_about"]" class="text-reset">
            <i class="bi bi-book mx-3 h4"></i>
        </a>
        <i class="bi bi-sliders mx-3 h4 cursorPointer" role="button" title="@L["#_settings"]"
           @onclick="() => settingsOpen = true"></i>
    </div>
</div>

@if (!supported) {
    <div class="alert alert-warning">
        This browser cannot open folders. The File System Access API is only in
        Chromium-based browsers &mdash; the same limitation the current app has.
    </div>
}

<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    <button class="btn btn-primary btn-sm" @onclick="OpenProject" disabled="@(!supported || busy)">
        @L["#_chooseOcadDirectory"]
    </button>

    @if (Project.IsOpen) {
        <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh" disabled="@busy">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
        <span class="text-muted small ms-2">
            @Project.Project.ProjectName
            @if (!string.IsNullOrEmpty(Project.Project.CurrentFileName)) {
                <text> / @Project.Project.CurrentFileName</text>
            }
        </span>
    }
</div>

@if (Project.IsOpen && Project.Project.OcdCandidates.Count > 1) {
    <div class="alert alert-info py-2">
        This folder has several <code>.ocd</code> files. Which one is the working file?
        @foreach (string candidate in Project.Project.OcdCandidates) {
            <button class="btn btn-sm ms-2 @(candidate == Project.Project.CurrentFileName ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="() => SelectCurrent(candidate)" disabled="@busy">@candidate</button>
        }
    </div>
}

@if (status is not null) {
    <p class="@(failed ? "text-danger" : "text-muted")">@status</p>
}

@if (Project.IsOpen) {
    <div class="row">
        <div class="col-md-3 d-flex flex-column">
            <VersionList Items="VersionItems()" SelectedNumber="selectedNumber" OnSelected="SelectVersion" />

            <div class="mt-auto py-3">
                <h5>@L.Format("#_createNewVersion", ("fileName", Project.Project.CurrentFileName))</h5>
                <div class="mb-2">
                    <label class="form-label small mb-1">@L["#_title"]</label>
                    <input class="form-control form-control-sm" @bind="newTitle" disabled="@busy"
                           placeholder="@L.Format("#_versionTitleHelper", ("newVersionName", Project.NextVersionName()), ("fileName", Project.Project.CurrentFileName))" />
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-1">@L["#_description"]</label>
                    <textarea class="form-control form-control-sm" rows="3"
                              @bind="newDescription" disabled="@busy"></textarea>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="CreateVersion"
                        disabled="@(busy || string.IsNullOrEmpty(Project.Project.CurrentFileName))">
                    @L.Format("#_newVersionSubmitText", ("newVersionName", Project.NextVersionName()), ("fileName", Project.Project.CurrentFileName))
                </button>
                <p class="text-muted small mt-2 mb-0">
                    Copies the working file into <code>Releases/@Project.NextVersionName()/</code>.
                    Symbol counts are written as zero until comparison exists.
                </p>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-center align-items-center gap-3 mb-1">
                @if (IsHistory) {
                    <i class="bi bi-book fs-4 text-primary" title="Comparing two past versions"></i>
                }
                <span class="fw-medium">@NewerLabel</span>
                <i class="bi bi-arrows"></i>
                <span class="fw-medium">@OlderLabel</span>
            </div>

            <OcadMapPair @ref="mapPair" LeftCaption="@NewerLabel" RightCaption="@($"{OlderLabel} (synced)")" />

            <DiffTable Diff="diff" Available="DiffSource.IsAvailable"
                       UnavailableReason="@DiffSource.UnavailableReason" />
        </div>
    </div>
}

<SettingsDialog @bind-Visible="settingsOpen" Georeference="@georeference" />

@code {
    private OcadMapPair mapPair;
    private bool supported = true;
    private bool busy;
    private string status;
    private bool failed;

    private MapDiff diff = MapDiff.Empty;
    private bool settingsOpen;
    private string georeference;

    /// <summary>Which version is being compared, 0 meaning the working file.</summary>
    private int selectedNumber;

    private string newTitle;
    private string newDescription;

    /// <summary>
    /// The newer side of the comparison, which is the selected version.
    /// </summary>
    private string NewerName => selectedNumber == 0
        ? ProjectService.CurrentVersionName
        : $"V{selectedNumber}";

    /// <summary>
    /// The older side: the highest-numbered version below the selected one. The
    /// working file compares against the newest release, which is the comparison
    /// the Angular app opens with.
    /// </summary>
    private string OlderName
    {
        get {
            var below = Project.Project?.Versions
                .Where(v => selectedNumber == 0 || v.Number < selectedNumber)
                .OrderByDescending(v => v.Number)
                .FirstOrDefault();
            return below?.Name ?? ProjectService.CurrentVersionName;
        }
    }

    private string NewerLabel => NewerName;
    private string OlderLabel => OlderName;

    /// <summary>True when looking at two past versions rather than the working file.</summary>
    private bool IsHistory => selectedNumber != 0;

    protected override async Task OnInitializedAsync()
    {
        // Changing language has to repaint this page, which owns most of the text.
        L.Changed += OnLanguageChanged;

        try {
            supported = await Project.IsSupportedAsync();
        }
        catch {
            supported = false;
        }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    private IReadOnlyList<VersionList.Item> VersionItems()
    {
        var items = new List<VersionList.Item> {
            new(0, ProjectService.CurrentVersionName,
                Project.Project.CurrentFileName ?? "no file selected",
                "The working file as it is on disk right now.",
                null, 0, 0, 0)
        };

        items.AddRange(Project.Project.Versions
            .OrderByDescending(v => v.Number)
            .Select(v => new VersionList.Item(
                v.Number, v.Name, v.Metadata.Title, v.Metadata.Description,
                v.Metadata.VersionCreatedAt,
                v.Metadata.NumberOfAddedSymbols,
                v.Metadata.NumberOfEditedSymbols,
                v.Metadata.NumberOfDeletedSymbols)));

        return items;
    }

    private async Task OpenProject()
        => await Run("Opening folder…", async () => {
            await Project.OpenAsync();
            selectedNumber = 0;
            await ShowComparison();
        },
        // The picker throws when the user cancels, which is not an error.
        ignore: ex => ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase));

    private async Task Refresh()
        => await Run("Re-reading folder…", async () => {
            await Project.RefreshAsync();
            await ShowComparison();
        });

    private async Task SelectCurrent(string fileName)
        => await Run($"Selecting {fileName}…", async () => {
            await Project.SelectCurrentFileAsync(fileName);
            await ShowComparison();
        });

    private async Task SelectVersion(int number)
        => await Run("Loading…", async () => {
            selectedNumber = number;
            await ShowComparison();
        });

    private async Task CreateVersion()
        => await Run("Creating version…", async () => {
            await Project.CreateVersionAsync(newTitle, newDescription);
            newTitle = newDescription = null;
            selectedNumber = 0;
            await ShowComparison();
        });

    /// <summary>Loads both sides and asks for the comparison between them.</summary>
    private async Task ShowComparison()
    {
        if (mapPair is null) return;

        string newer = NewerName, older = OlderName;

        var loaded = await mapPair.LoadAsync(0, $"{newer}.ocd", await Project.ReadMapAsync(newer));
        georeference = loaded.Georeference;
        await mapPair.LoadAsync(1, $"{older}.ocd", await Project.ReadMapAsync(older));

        diff = await DiffSource.CompareAsync(older, newer);
    }

    /// <summary>Runs an action with the progress bar, busy flag and error reporting.</summary>
    private async Task Run(string message, Func<Task> action, Func<Exception, bool> ignore = null)
    {
        busy = true;
        failed = false;
        status = message;
        StateHasChanged();
        await Task.Yield();

        try {
            await action();
            status = null;
        }
        catch (Exception ex) when (ignore?.Invoke(ex) == true) {
            status = null;
        }
        catch (Exception ex) {
            failed = true;
            status = ex.Message;
        }
        finally {
            busy = false;
            StateHasChanged();
        }
    }
}
