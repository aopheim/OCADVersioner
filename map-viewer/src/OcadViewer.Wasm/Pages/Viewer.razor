@page "/"
@using System.Diagnostics
@using OcadViewer.Wasm.Components

<PageTitle>OCAD map viewer</PageTitle>

<h1>OCAD map viewer</h1>

<p class="text-muted">
    Two synced maps, drawn by PurplePen's renderer running in WebAssembly and
    delivered as Leaflet tiles. Pan or zoom either side &mdash; the other follows.
</p>

<div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
    <label class="mb-0">
        <span class="text-muted small d-block">Left map</span>
        <InputFile OnChange="@(e => Load(0, e))" accept=".ocd,.ocad" class="form-control form-control-sm" />
    </label>
    <label class="mb-0">
        <span class="text-muted small d-block">Right map</span>
        <InputFile OnChange="@(e => Load(1, e))" accept=".ocd,.ocad" class="form-control form-control-sm" />
    </label>
    <button class="btn btn-outline-secondary btn-sm align-self-end" @onclick="RefreshStats">
        Refresh stats
    </button>
</div>

@if (status is not null) {
    <p class="@(failed ? "text-danger" : "text-muted")">@status</p>
}

<OcadMapPair @ref="mapPair" LeftCaption="left" RightCaption="right (synced)" />

@if (loads.Count > 0 || stats is not null) {
    <pre class="ocad-stats">@StatsText()</pre>
}

@code {
    private OcadMapPair mapPair;
    private readonly Dictionary<int, LoadRecord> loads = [];
    private OcadMapPair.TileStats stats;
    private string status;
    private bool failed;

    private sealed record LoadRecord(string Name, long Bytes, OcadMapPair.MapLoadInfo Info, long WallMs);

    private async Task Load(int slot, InputFileChangeEventArgs e)
    {
        IBrowserFile file = e.File;
        if (file is null || mapPair is null)
            return;

        failed = false;
        status = $"Reading {file.Name}…";
        StateHasChanged();
        await Task.Yield();

        try {
            // 256 MB ceiling: real survey maps run to tens of megabytes, and the
            // default 512 KB limit would reject almost all of them.
            byte[] bytes;
            await using (Stream stream = file.OpenReadStream(maxAllowedSize: 256L * 1024 * 1024)) {
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }

            status = $"Parsing and rendering {file.Name}…";
            StateHasChanged();
            await Task.Yield();

            var stopwatch = Stopwatch.StartNew();
            OcadMapPair.MapLoadInfo info = await mapPair.LoadAsync(slot, file.Name, bytes);
            stopwatch.Stop();

            loads[slot] = new LoadRecord(file.Name, bytes.LongLength, info, stopwatch.ElapsedMilliseconds);
            status = null;
        }
        catch (Exception ex) {
            failed = true;
            status = $"{ex.GetType().Name}: {ex.Message}";
        }

        await RefreshStats();
    }

    private async Task RefreshStats()
    {
        if (mapPair is not null)
            stats = await mapPair.GetStatsAsync();
        StateHasChanged();
    }

    private string StatsText()
    {
        var lines = new List<string>();

        foreach ((int slot, LoadRecord load) in loads.OrderBy(kv => kv.Key)) {
            lines.Add($"slot {slot}        {load.Name} ({load.Bytes / 1048576.0:F1} MB), OCAD {load.Info.Version}");
            lines.Add($"  bounds      {load.Info.MaxX - load.Info.MinX:F1} x {load.Info.MaxY - load.Info.MinY:F1} mm");
            lines.Add($"  parse       {load.Info.ParseMs} ms");
            lines.Add($"  load+fit    {load.WallMs} ms");
            lines.Add($"  georef      {load.Info.Georeference}");
        }

        if (stats is not null) {
            lines.Add("");
            lines.Add($"tiles drawn   {stats.Drawn}  (stale {stats.Stale}, outside {stats.Outside}, "
                    + $"cancelled {stats.Cancelled}, queued {stats.Queued})");
            lines.Add($"tile render   avg {stats.AvgMs:F1} ms, slowest {stats.MaxMs:F1} ms");
            lines.Add($"sum of tiles  {stats.TotalMs:F0} ms");
        }

        return string.Join('\n', lines);
    }
}
