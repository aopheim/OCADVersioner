@page "/"
@using OcadViewer.Wasm.Components
@using OcadViewer.Wasm.Services
@inject ProjectService Project

<PageTitle>OCAD map viewer</PageTitle>

<h1>OCAD map viewer</h1>

@if (!supported) {
    <div class="alert alert-warning">
        This browser cannot open folders. The File System Access API is only in
        Chromium-based browsers &mdash; the same limitation the current app has.
    </div>
}

<div class="d-flex align-items-end gap-3 mb-3 flex-wrap">
    <button class="btn btn-primary" @onclick="OpenProject" disabled="@(!supported || busy)">
        @(Project.IsOpen ? "Open another folder" : "Open project folder")
    </button>

    @if (Project.IsOpen) {
        <button class="btn btn-outline-secondary" @onclick="Refresh" disabled="@busy">Refresh</button>

        <label class="mb-0">
            <span class="text-muted small d-block">Left (newer)</span>
            <select class="form-select form-select-sm" style="width:12rem"
                    value="@leftVersion" @onchange="e => ShowVersion(0, e)" disabled="@busy">
                @foreach (var option in VersionOptions()) {
                    <option value="@option.Name">@option.Label</option>
                }
            </select>
        </label>

        <label class="mb-0">
            <span class="text-muted small d-block">Right (older)</span>
            <select class="form-select form-select-sm" style="width:12rem"
                    value="@rightVersion" @onchange="e => ShowVersion(1, e)" disabled="@busy">
                @foreach (var option in VersionOptions()) {
                    <option value="@option.Name">@option.Label</option>
                }
            </select>
        </label>
    }
</div>

@if (Project.IsOpen && Project.Project.OcdCandidates.Count > 1) {
    <div class="alert alert-info py-2">
        This folder has several <code>.ocd</code> files. Which one is the working file?
        @foreach (string candidate in Project.Project.OcdCandidates) {
            <button class="btn btn-sm @(candidate == Project.Project.CurrentFileName ? "btn-secondary" : "btn-outline-secondary") ms-2"
                    @onclick="() => SelectCurrent(candidate)" disabled="@busy">@candidate</button>
        }
    </div>
}

@if (status is not null) {
    <p class="@(failed ? "text-danger" : "text-muted")">@status</p>
}

@if (Project.IsOpen) {
    <div class="row g-3 mb-3">
        <div class="col-md-5">
            <h2 class="h6">@Project.Project.ProjectName</h2>
            <table class="table table-sm">
                <thead>
                    <tr><th>Version</th><th>Created</th><th>Title</th></tr>
                </thead>
                <tbody>
                    <tr class="@(leftVersion == ProjectService.CurrentVersionName || rightVersion == ProjectService.CurrentVersionName ? "table-active" : "")">
                        <td><strong>current</strong></td>
                        <td class="text-muted">working file</td>
                        <td>@(Project.Project.CurrentFileName ?? "none selected")</td>
                    </tr>
                    @foreach (var version in Project.Project.Versions.OrderByDescending(v => v.Number)) {
                        <tr class="@(leftVersion == version.Name || rightVersion == version.Name ? "table-active" : "")">
                            <td><strong>@version.Name</strong></td>
                            <td class="text-muted">@version.Metadata.VersionCreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@version.Metadata.Title</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-md-5">
            <h2 class="h6">Create @Project.NextVersionName()</h2>
            <input class="form-control form-control-sm mb-2" placeholder="Title" @bind="newTitle" disabled="@busy" />
            <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="Description"
                      @bind="newDescription" disabled="@busy"></textarea>
            <button class="btn btn-outline-primary btn-sm" @onclick="CreateVersion"
                    disabled="@(busy || string.IsNullOrEmpty(Project.Project.CurrentFileName))">
                Create version
            </button>
            <p class="text-muted small mt-2 mb-0">
                Copies the working file into <code>Releases/@Project.NextVersionName()/</code>.
                Symbol counts are written as zero until the diff is ported.
            </p>
        </div>
    </div>
}

<OcadMapPair @ref="mapPair" LeftCaption="@leftVersion" RightCaption="@(rightVersion + " (synced)")" />

@code {
    private OcadMapPair mapPair;
    private bool supported = true;
    private bool busy;
    private string status;
    private bool failed;

    private string leftVersion = ProjectService.CurrentVersionName;
    private string rightVersion = ProjectService.CurrentVersionName;

    private string newTitle;
    private string newDescription;

    private sealed record VersionOption(string Name, string Label);

    private IEnumerable<VersionOption> VersionOptions()
    {
        yield return new VersionOption(ProjectService.CurrentVersionName, "current");
        foreach (var version in Project.Project.Versions.OrderByDescending(v => v.Number))
            yield return new VersionOption(version.Name, version.Metadata.Title is { Length: > 0 } title
                ? $"{version.Name} — {title}"
                : version.Name);
    }

    protected override async Task OnInitializedAsync()
    {
        try {
            supported = await Project.IsSupportedAsync();
        }
        catch {
            supported = false;
        }
    }

    private async Task OpenProject()
    {
        await Run("Opening folder…", async () => {
            await Project.OpenAsync();
            ChooseInitialVersions();
            await ShowBoth();
        },
        // The picker throws when the user cancels, which is not an error.
        ignore: ex => ex.Message.Contains("abort", StringComparison.OrdinalIgnoreCase));
    }

    private async Task Refresh()
        => await Run("Re-reading folder…", async () => await Project.RefreshAsync());

    private async Task SelectCurrent(string fileName)
        => await Run($"Selecting {fileName}…", async () => {
            await Project.SelectCurrentFileAsync(fileName);
            await ShowBoth();
        });

    private async Task CreateVersion()
        => await Run("Creating version…", async () => {
            await Project.CreateVersionAsync(newTitle, newDescription);
            newTitle = newDescription = null;
            ChooseInitialVersions();
            await ShowBoth();
        });

    /// <summary>
    /// Defaults to the newest release on the right and the working file on the left,
    /// which is the comparison the Angular app opens with.
    /// </summary>
    private void ChooseInitialVersions()
    {
        leftVersion = ProjectService.CurrentVersionName;
        var newest = Project.Project.Versions.OrderByDescending(v => v.Number).FirstOrDefault();
        rightVersion = newest?.Name ?? ProjectService.CurrentVersionName;
    }

    private async Task ShowVersion(int slot, ChangeEventArgs e)
    {
        string name = e.Value?.ToString();
        if (string.IsNullOrEmpty(name)) return;

        if (slot == 0) leftVersion = name; else rightVersion = name;
        await Run($"Loading {name}…", async () => await Load(slot, name));
    }

    private async Task ShowBoth()
    {
        await Load(0, leftVersion);
        await Load(1, rightVersion);
    }

    private async Task Load(int slot, string versionName)
    {
        if (mapPair is null) return;

        byte[] bytes = await Project.ReadMapAsync(versionName);
        await mapPair.LoadAsync(slot, $"{versionName}.ocd", bytes);
    }

    /// <summary>Runs an action with a status message, busy flag and error reporting.</summary>
    private async Task Run(string message, Func<Task> action, Func<Exception, bool> ignore = null)
    {
        busy = true;
        failed = false;
        status = message;
        StateHasChanged();
        await Task.Yield();

        try {
            await action();
            status = null;
        }
        catch (Exception ex) when (ignore?.Invoke(ex) == true) {
            status = null;
        }
        catch (Exception ex) {
            failed = true;
            status = ex.Message;
        }
        finally {
            busy = false;
            StateHasChanged();
        }
    }
}
