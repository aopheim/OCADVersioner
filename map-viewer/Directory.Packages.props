<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions mirror PurplePen's src/Directory.Packages.props at the vendored
         commit (see vendor/UPSTREAM.md). Keep them in step when syncing. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.Views.Blazor" Version="3.119.4" />
    <!-- HarfBuzz shaping needs its native library linked into the WebAssembly
         module; that does not arrive transitively for the browser target. -->
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.1.5" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.8" />

    <!--
    Do not upgrade ImageSharp past 2.1.3. Later versions carry the Six Labors Split
    License; 2.1.3 is the last Apache-2.0 release. The known advisories only apply
    when decoding untrusted images, which this app does not do - it decodes bitmap
    templates embedded in map files the user already opened. This pin and the
    suppressions below are inherited from upstream PurplePen on purpose.
    -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="[2.1.3]" NoWarn="NU1901;NU1902;NU1903;NU1904" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="Microsoft.Playwright.NUnit" Version="1.55.0" />
  </ItemGroup>

  <!-- Suppress NuGet audit warnings for SixLabors.ImageSharp across all projects,
       including transitive references. See the comment above for the reasoning. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2cmq-823j-5qj8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5x7m-6737-26cr" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-63p8-c4ww-9cg7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-65x7-c272-7g7r" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g85r-6x2q-45w7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qxrv-gp6x-rc23" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rxmq-m78w-7wmc" />
  </ItemGroup>
</Project>
