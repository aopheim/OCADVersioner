# See http://help.github.com/ignore-files/ for more about ignoring files.

# Node
node_modules/
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# System files
.DS_Store
Thumbs.db

.env

# .NET (map-viewer)
[Bb]in/
[Oo]bj/
*.user
.vs/

# Local render output from OcadViewer.RenderCli
artifacts/

# Generated by the StageVendorFonts target from map-viewer/vendor
map-viewer/src/OcadViewer.Wasm/wwwroot/fonts/

# Local-only test maps for the Blazor viewer; never publish these
map-viewer/src/OcadViewer.Wasm/wwwroot/testmaps/

# The 9.8 MB benchmark map is passed around by hand, not committed
map-viewer/testdata/large_map.ocd

# Staged into the tile spike by MSBuild from vendor/ and node_modules
map-viewer/src/OcadViewer.TileSpike/wwwroot/fonts/
map-viewer/src/OcadViewer.TileSpike/wwwroot/lib/

# Generated into the Blazor app by MSBuild from the repo root
map-viewer/src/OcadViewer.Wasm/wwwroot/third-party-notices.txt
